# Backend environment configuration
# Copy this file to .env and fill in values appropriate for your environment.
# Never commit .env to version control.

# ── LLM provider ──────────────────────────────────────────────────────────────
# Allowed values: fake | gemini | groq | openrouter | ollama
# Phase 0 default: fake (no external calls, scripted responses for testing)
LLM_PROVIDER=fake

# ── API keys (leave blank when LLM_PROVIDER=fake) ─────────────────────────────
# Add the key for whichever real provider you choose in Phase 1/2.
# Real LLM providers are added only after decision §16.1 is resolved.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Database (Phase 2+) ───────────────────────────────────────────────────────
# SQLite for local development; PostgreSQL for production.
# DATABASE_URL=sqlite+aiosqlite:///./data/cdss.db

# ── ChromaDB (Phase 1+) ───────────────────────────────────────────────────────
# CHROMA_PATH=./data/chroma

# ── Privacy ──────────────────────────────────────────────────────────────────
# Block requests containing obvious personal identifiers before any external call.
BLOCK_ON_IDENTIFIER=true

